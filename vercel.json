{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/app-manifest.webmanifest",
      "destination": "/api/pwa?asset=manifest"
    },
    {
      "source": "/app-icon-192.png",
      "destination": "/api/pwa?asset=icon-192"
    },
    {
      "source": "/app-icon-512.png",
      "destination": "/api/pwa?asset=icon-512"
    },
    {
      "source": "/app-icon-maskable-512.png",
      "destination": "/api/pwa?asset=icon-maskable-512"
    },
    {
      "source": "/app-apple-touch-icon.png",
      "destination": "/api/pwa?asset=apple-touch-icon"
    },
    {
      "source": "/.netlify/functions/pwa",
      "destination": "/api/pwa"
    },
    {
      "source": "/.netlify/functions/courier",
      "destination": "/api/courier"
    },
    {
      "source": "/((?!api/|assets/|app-manifest\\.webmanifest|app-icon-|app-apple-touch-icon\\.png|.*\\.(?:js|mjs|css|png|jpg|jpeg|gif|svg|webp|ico|json|webmanifest|woff|woff2|ttf|txt|xml|map)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/workbox-(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/pwa-branding-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/firebase-config.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/app-manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/app-icon-192.png",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/app-icon-512.png",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/app-icon-maskable-512.png",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/app-apple-touch-icon.png",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
